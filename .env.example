# Copy to .env and adjust. All values are local dev placeholders — never put real credentials here.

# --- Postgres (docker compose `db` service) ---
POSTGRES_USER=rca_admin
POSTGRES_PASSWORD=rca_admin
POSTGRES_DB=rca

# --- App (rca.config.Settings, prefix RCA_) ---
# Host-side URLs; inside compose, the `app` service overrides these to point at `db`.
RCA_DATABASE_URL=postgresql://rca_app:rca_app@localhost:5432/rca
RCA_READONLY_DATABASE_URL=postgresql://rca_readonly:rca_readonly@localhost:5432/rca
# Superuser — migrations and integration-test setup only.
RCA_ADMIN_DATABASE_URL=postgresql://rca_admin:rca_admin@localhost:5432/rca

# Simulator
RCA_DAGS_DIR=dags
RCA_SIM_SEED=42

# Monitors
RCA_MONITORS_CONFIG=monitors/datasets.yaml

# Fault scenarios
RCA_SCENARIOS_DIR=eval/scenarios

# LLM — leave blank to run with replay/fallback only.
ANTHROPIC_API_KEY=
RCA_MODEL=claude-opus-5-5
RCA_EFFORT=high
RCA_LLM_TIMEOUT_S=120
RCA_LLM_FALLBACKS=true

# Agent budgets (tokens summed over all LLM calls of one triage)
RCA_MAX_STEPS=12
RCA_TOKEN_BUDGET=400000

# Retrieval
RCA_ONCALL_DIR=oncall
RCA_EMBEDDER=fastembed
RCA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# fastembed model cache (the app container mounts a volume at /models)
RCA_EMBEDDING_CACHE_DIR=

RCA_LOG_LEVEL=INFO
